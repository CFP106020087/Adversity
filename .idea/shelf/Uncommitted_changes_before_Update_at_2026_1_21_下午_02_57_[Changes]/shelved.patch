-                player.posX, player.posY + 1, player.posZ,
-                20,
-                0.5, 0.5, 0.5,
-                0.1
-            );
-            ((WorldServer) player.world).spawnParticle(
-                EnumParticleTypes.SMOKE_NORMAL,
-                player.posX, player.posY + 1, player.posZ,
