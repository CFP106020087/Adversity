-                cap.setDifficultyDisabled(false);
-                cap.resetKillCount();
-                notifySuccess(sender, targetPlayer, "Difficulty reset to default (Normal)");
-                break;
-
-            default:
-                throw new CommandException("Unknown subcommand: " + subcommand + ". Use: set, preset, disable, enable, reset");
-        }
-    }
-
-    /**
