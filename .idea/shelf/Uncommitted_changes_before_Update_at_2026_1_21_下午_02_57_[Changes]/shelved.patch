-    public static void retainOnly(java.util.Set<Integer> validIds) {
-        CACHE.keySet().retainAll(validIds);
-    }
-
-    /**
-     * 检查实体是否在缓存中
-     */
-    public static boolean hasEntity(int entityId) {
-        return CACHE.containsKey(entityId);
-    }
-}
