-        PacketSyncAdversity packet = new PacketSyncAdversity(
-            entity.getEntityId(),
-            cap.getTier(),
-            cap.getDifficultyLevel(),
-            cap.getHealthMultiplier(),
-            cap.getDamageMultiplier(),
-            affixIds
-        );
-
-        PacketHandler.INSTANCE.sendToAllTracking(packet, entity);
-    }
-}
