-
-        // 解析目标玩家
-        if (args.length < 2) {
-            throw new CommandException("Usage: /adversity <player> <set|preset|disable|enable|reset> [value]");
-        }
-
-        EntityPlayerMP targetPlayer = getPlayer(server, sender, args[0]);
