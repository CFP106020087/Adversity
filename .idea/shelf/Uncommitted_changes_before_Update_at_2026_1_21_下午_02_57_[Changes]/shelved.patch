-
-        // 每 tick 更新玩家看向的实体（用于UI显示）
-        updateLookedAtEntity(mc);
-
-        // 每 5 tick 生成粒子（减少性能开销）
-        tickCounter++;
-        if (tickCounter % 5 == 0) {
-            spawnTierParticles(mc);
-        }
-    }
