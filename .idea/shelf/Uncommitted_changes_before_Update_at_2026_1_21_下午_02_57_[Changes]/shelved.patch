-            Iterator<SuppressionZone> it = zones.iterator();
-            while (it.hasNext()) {
-                SuppressionZone zone = it.next();
-                zone.remainingTicks--;
-
-                if (zone.remainingTicks <= 0) {
-                    it.remove();
-                    Adversity.LOGGER.debug("Suppression zone expired at {} in dimension {}",
-                        zone.center, dimension);
-                }
-            }
-        }
-    }
