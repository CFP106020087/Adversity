-
-        EntityPlayer player = (EntityPlayer) target;
-        int tier = getTier(attacker);
-
-        // 获取玩家吸收值
-        float absorptionAmount = player.getAbsorptionAmount();
-
-        // 无吸收值不触发
-        if (absorptionAmount <= 0) {
-            return damage;
-        }
-
-        // 计算伤害加成
