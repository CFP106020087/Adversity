-        double range = BASE_AURA_RANGE + tier * RANGE_PER_TIER;
-
-        AxisAlignedBB area = entity.getEntityBoundingBox().grow(range);
-        List<EntityPlayer> nearbyPlayers = entity.world.getEntitiesWithinAABB(
