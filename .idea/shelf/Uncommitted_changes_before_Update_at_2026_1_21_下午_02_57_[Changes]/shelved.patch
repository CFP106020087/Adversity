-                player.posX, player.posY + 1, player.posZ,
-                15,
-                0.5, 0.5, 0.5,
-                0.0
-            );
-        }
-    }
-
-    private int getTier(EntityLiving entity) {
-        IAdversityCapability cap = CapabilityHandler.getCapability(entity);
-        return cap != null ? cap.getTier() : 1;
-    }
